<?xml version='1.0' encoding='UTF-8'?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <description>Keep and Grow demo. When the agent resolves a case Fin handed off, alert the account owner (renewal brief task and Slack post to #sales-notifications), but only for multi-location accounts where Fin flagged churn risk or growth.</description>
    <label>Yelp - Fin Case Resolved Alert</label>
    <processType>AutoLaunchedFlow</processType>
    <status>Active</status>
    <interviewLabel>Fin Resolved Alert {!$Record.CaseNumber}</interviewLabel>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>FinInvolved__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Origin</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Chat</stringValue>
            </value>
        </filters>
        <filters>
            <field>AccountId</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>FinResolutionState__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Routed to team</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Closed</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Case</object>
        <recordTriggerType>Update</recordTriggerType>
        <scheduledPaths>
            <connector>
                <targetReference>Notify_Owner</targetReference>
            </connector>
            <pathType>AsyncAfterCommit</pathType>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <decisions>
        <name>Notify_Owner</name>
        <label>Does the account owner need to know?</label>
        <locationX>600</locationX>
        <locationY>150</locationY>
        <defaultConnectorLabel>No alert</defaultConnectorLabel>
        <rules>
            <name>Multi_Location_Signal</name>
            <conditionLogic>1 AND 4 AND (2 OR 3)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Account.Location_Count__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>3.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Churn_Risk__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>High</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Expansion_Signal__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Account.Annual_Ad_Spend__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>50000.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Locations</targetReference>
            </connector>
            <label>Multi-location account, $50K+ spend, with churn risk or growth</label>
        </rules>
    </decisions>
    <recordCreates>
        <name>Create_Brief</name>
        <label>Send renewal brief to account owner</label>
        <connector>
            <targetReference>Post_to_Slack</targetReference>
        </connector>
        <locationX>176</locationX>
        <locationY>1230</locationY>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <elementReference>BriefSubject</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Description</field>
            <value>
                <elementReference>Brief</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhatId</field>
            <value>
                <elementReference>$Record.AccountId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhoId</field>
            <value>
                <elementReference>$Record.ContactId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>$Record.Account.OwnerId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ActivityDate</field>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Priority</field>
            <value>
                <stringValue>High</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Not Started</stringValue>
            </value>
        </inputAssignments>
        <object>Task</object>
    </recordCreates>
    <recordLookups>
        <name>Get_Locations</name>
        <label>Get Locations</label>
        <locationX>176</locationX>
        <locationY>510</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Locations</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ParentId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.AccountId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Account</object>
        <sortField>Name</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Open_Cases</name>
        <label>Get Open Cases</label>
        <locationX>176</locationX>
        <locationY>870</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Count_Open_Cases</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AccountId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.AccountId</elementReference>
            </value>
        </filters>
        <filters>
            <field>IsClosed</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Case</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Renewal</name>
        <label>Get Renewal</label>
        <locationX>176</locationX>
        <locationY>1110</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Expansion</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AccountId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.AccountId</elementReference>
            </value>
        </filters>
        <filters>
            <field>IsClosed</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Name</field>
            <operator>Contains</operator>
            <value>
                <stringValue>Renewal</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Opportunity</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Expansion</name>
        <label>Get Expansion Opportunity</label>
        <locationX>600</locationX>
        <locationY>1200</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Summarize_Support</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AccountId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.AccountId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Type</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Add-On Business</stringValue>
            </value>
        </filters>
        <filters>
            <field>IsClosed</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Opportunity</object>
        <sortField>CreatedDate</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <loops>
        <name>Loop_Locations</name>
        <label>Each location</label>
        <locationX>176</locationX>
        <locationY>630</locationY>
        <collectionReference>Get_Locations</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Add_Location_Line</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Get_Open_Cases</targetReference>
        </noMoreValuesConnector>
    </loops>
    <assignments>
        <name>Add_Location_Line</name>
        <label>Add location line</label>
        <locationX>264</locationX>
        <locationY>750</locationY>
        <assignmentItems>
            <assignToReference>SpendByLocation</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>NL</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>SpendByLocation</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>LocationLine</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Locations</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Count_Open_Cases</name>
        <label>Count open cases</label>
        <locationX>176</locationX>
        <locationY>990</locationY>
        <assignmentItems>
            <assignToReference>OpenCases</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>Get_Open_Cases</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_Renewal</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Slack_Failed</name>
        <label>Slack post failed (brief task still created)</label>
        <locationX>440</locationX>
        <locationY>1470</locationY>
        <assignmentItems>
            <assignToReference>SlackError</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <constants>
        <name>NL</name>
        <dataType>String</dataType>
        <value>
            <stringValue>
</stringValue>
        </value>
    </constants>
    <formulas>
        <name>LocationStatus</name>
        <dataType>String</dataType>
        <expression>IF(TEXT({!Loop_Locations.Budget_Status__c}) = "Active", "", " (" &amp; TEXT({!Loop_Locations.Budget_Status__c}) &amp; ")")</expression>
    </formulas>
    <formulas>
        <name>BriefSubject</name>
        <dataType>String</dataType>
        <expression>"Renewal brief: " &amp; {!$Record.Account.Name}</expression>
    </formulas>
    <formulas>
        <name>NextStep</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!$Record.Expansion_Signal__c}), "", "Book an Ads Optimization Review session with " &amp; {!$Record.Contact.FirstName} &amp; " to plan launch budgets for the " &amp; {!$Record.Expansion_Signal__c} &amp; ", and scope the expansion opportunity. ") &amp; IF(TEXT({!$Record.Retention_Offer__c}) = "90-day pause", "Set up a call with " &amp; {!$Record.Contact.FirstName} &amp; " to optimize " &amp; {!$Record.Fin_Location__c} &amp; " location spend during the 90-day pause. ", "") &amp; IF(TEXT({!$Record.Churn_Risk__c}) = "High", "Follow up on the churn risk before the renewal.", "Confirm the value " &amp; {!$Record.Contact.FirstName} &amp; " is seeing before the renewal.")</expression>
    </formulas>
    <formulas>
        <name>OppLink</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!Get_Expansion.Id}), "", "  |  &lt;https://trailsignup-429cdfd78ec835.lightning.force.com/lightning/app/06mg800000AlQvwAAF/r/Opportunity/" &amp; {!Get_Expansion.Id} &amp; "/view|New expansion opportunity&gt;")</expression>
    </formulas>
    <textTemplates>
        <name>LocationLine</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>- {!Loop_Locations.Name}: ${!Loop_Locations.Monthly_Budget_Cap__c}/mo, {!Loop_Locations.Leads_Last_30_Days__c} leads, ${!Loop_Locations.Cost_Per_Lead__c}/lead{!LocationStatus}</text>
    </textTemplates>
    <textTemplates>
        <name>Brief</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>Fin flagged {!$Record.Account.Name} in a conversation with {!$Record.Contact.FirstName} {!$Record.Contact.LastName} today.

Einstein account health
- Likelihood to renew: {!$Record.Account.Renewal_Likelihood__c} / 100 ({!$Record.Account.Renewal_Outlook__c})
- {!Get_Renewal.Name}: ${!Get_Renewal.Amount}, closes {!Get_Renewal.CloseDate}

{!SupportSummary}

Spend by location{!SpendByLocation}

Suggested next step
{!NextStep}

Fin summary
{!$Record.Fin_Summary__c}</text>
    </textTemplates>
    <textTemplates>
        <name>SlackBrief</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>&lt;@U0C51E32VL6&gt; *Fin alert for {!$Record.Account.Owner.FirstName}: {!$Record.Account.Name}* ({!$Record.Account.Location_Count__c} locations)
&lt;https://trailsignup-429cdfd78ec835.lightning.force.com/lightning/app/06mg800000AlQvwAAF/r/Opportunity/{!Get_Renewal.Id}/view|Open the renewal opportunity&gt;{!OppLink}  |  &lt;https://trailsignup-429cdfd78ec835.lightning.force.com/lightning/app/06mg800000AlQvwAAF/r/Account/{!$Record.AccountId}/view|Account&gt;

_Why you're getting this: you own this multi-location account (${!$Record.Account.Annual_Ad_Spend__c} annual ad spend), and Fin flagged growth or churn risk in tonight's conversation with {!$Record.Contact.FirstName} {!$Record.Contact.LastName}._

*Einstein account health*
- Likelihood to renew: *{!$Record.Account.Renewal_Likelihood__c}* / 100 ({!$Record.Account.Renewal_Outlook__c})
- {!Get_Renewal.Name}: ${!Get_Renewal.Amount}, closes {!Get_Renewal.CloseDate}

{!SupportSummary}

*Spend by location*{!SpendByLocation}

*Suggested next step*
{!NextStep}</text>
    </textTemplates>
    <variables>
        <name>SupportSummary</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>SpendByLocation</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>OpenCases</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
    </variables>
    <variables>
        <name>SlackError</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <actionCalls>
        <description>Recent support on the account (last 90 days), positive signals and what to watch.</description>
        <name>Summarize_Support</name>
        <label>Summarize recent support</label>
        <locationX>600</locationX>
        <locationY>1320</locationY>
        <actionName>YelpSupportSummary</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Create_Brief</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>caseId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <outputParameters>
            <assignToReference>SupportSummary</assignToReference>
            <name>summary</name>
        </outputParameters>
        <storeOutputAutomatically>false</storeOutputAutomatically>
    </actionCalls>
    <actionCalls>
        <name>Post_to_Slack</name>
        <label>Post renewal brief to #sales-notifications</label>
        <locationX>176</locationX>
        <locationY>1350</locationY>
        <actionName>slackPostMessage</actionName>
        <actionType>slackPostMessage</actionType>
        <faultConnector>
            <targetReference>Slack_Failed</targetReference>
        </faultConnector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>slackAppIdForToken</name>
            <value>
                <stringValue>A028VJ1KG3G</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>slackWorkspaceIdForToken</name>
            <value>
                <stringValue>T0C4N1TMPN3</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>slackConversationId</name>
            <value>
                <stringValue>C0CC7K9PY06</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>slackMessage</name>
            <value>
                <elementReference>SlackBrief</elementReference>
            </value>
        </inputParameters>
        <nameSegment>slackPostMessage</nameSegment>
    </actionCalls>
</Flow>