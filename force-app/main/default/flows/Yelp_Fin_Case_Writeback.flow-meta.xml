<?xml version='1.0' encoding='UTF-8'?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <description>Keep and Grow demo. When Fin hands a conversation to the team, write Fin's churn risk, expansion signal and sentiment back to the Account, open an Expansion opportunity if Fin heard one, and send the account owner a renewal brief.</description>
    <label>Yelp - Fin Case Write-back</label>
    <processType>AutoLaunchedFlow</processType>
    <status>Active</status>
    <interviewLabel>Fin Write-back {!$Record.CaseNumber}</interviewLabel>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Account</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>FinInvolved__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Origin</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Chat</stringValue>
            </value>
        </filters>
        <filters>
            <field>AccountId</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Case</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <recordUpdates>
        <name>Update_Account</name>
        <label>Write Fin signals to Account</label>
        <locationX>176</locationX>
        <locationY>150</locationY>
        <connector>
            <targetReference>Has_Expansion</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.AccountId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Churn_Risk__c</field>
            <value>
                <elementReference>$Record.Churn_Risk__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Churn_Risk_Reason__c</field>
            <value>
                <elementReference>$Record.Churn_Risk_Reason__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Expansion_Signal__c</field>
            <value>
                <elementReference>$Record.Expansion_Signal__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Fin_Sentiment__c</field>
            <value>
                <elementReference>$Record.Fin_Sentiment__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Last_Fin_Conversation__c</field>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </inputAssignments>
        <object>Account</object>
    </recordUpdates>
    <decisions>
        <name>Has_Expansion</name>
        <label>Did Fin hear an expansion signal?</label>
        <locationX>176</locationX>
        <locationY>270</locationY>
        <defaultConnector>
            <targetReference>Get_Locations</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_Expansion</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Expansion_Signal__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Expansion</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <recordCreates>
        <name>Create_Expansion</name>
        <label>Create Expansion Opportunity</label>
        <locationX>50</locationX>
        <locationY>390</locationY>
        <assignRecordIdToReference>ExpansionId</assignRecordIdToReference>
        <connector>
            <targetReference>Get_Locations</targetReference>
        </connector>
        <inputAssignments>
            <field>Name</field>
            <value>
                <elementReference>ExpansionName</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>AccountId</field>
            <value>
                <elementReference>$Record.AccountId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>$Record.Account.OwnerId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Type</field>
            <value>
                <stringValue>Add-On Business</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>StageName</field>
            <value>
                <stringValue>Qualification</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>CloseDate</field>
            <value>
                <elementReference>ExpansionClose</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Amount</field>
            <value>
                <elementReference>ExpansionAmount</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Description</field>
            <value>
                <elementReference>ExpansionDescription</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Part2_Demo__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <object>Opportunity</object>
    </recordCreates>
    <recordCreates>
        <name>Create_Brief</name>
        <label>Send renewal brief to account owner</label>
        <locationX>176</locationX>
        <locationY>1230</locationY>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <elementReference>BriefSubject</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Description</field>
            <value>
                <elementReference>Brief</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhatId</field>
            <value>
                <elementReference>$Record.AccountId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhoId</field>
            <value>
                <elementReference>$Record.ContactId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>$Record.Account.OwnerId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ActivityDate</field>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Priority</field>
            <value>
                <stringValue>High</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Not Started</stringValue>
            </value>
        </inputAssignments>
        <object>Task</object>
    </recordCreates>
    <recordLookups>
        <name>Get_Locations</name>
        <label>Get Locations</label>
        <locationX>176</locationX>
        <locationY>510</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Locations</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ParentId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.AccountId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Account</object>
        <sortField>Name</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Open_Cases</name>
        <label>Get Open Cases</label>
        <locationX>176</locationX>
        <locationY>870</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Count_Open_Cases</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AccountId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.AccountId</elementReference>
            </value>
        </filters>
        <filters>
            <field>IsClosed</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Case</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Renewal</name>
        <label>Get Renewal</label>
        <locationX>176</locationX>
        <locationY>1110</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Create_Brief</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AccountId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.AccountId</elementReference>
            </value>
        </filters>
        <filters>
            <field>IsClosed</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Name</field>
            <operator>Contains</operator>
            <value>
                <stringValue>Renewal</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Opportunity</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <loops>
        <name>Loop_Locations</name>
        <label>Each location</label>
        <locationX>176</locationX>
        <locationY>630</locationY>
        <collectionReference>Get_Locations</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Add_Location_Line</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Get_Open_Cases</targetReference>
        </noMoreValuesConnector>
    </loops>
    <assignments>
        <name>Add_Location_Line</name>
        <label>Add location line</label>
        <locationX>264</locationX>
        <locationY>750</locationY>
        <assignmentItems>
            <assignToReference>SpendByLocation</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>NL</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>SpendByLocation</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>LocationLine</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Locations</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Count_Open_Cases</name>
        <label>Count open cases</label>
        <locationX>176</locationX>
        <locationY>990</locationY>
        <assignmentItems>
            <assignToReference>OpenCases</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>Get_Open_Cases</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_Renewal</targetReference>
        </connector>
    </assignments>
    <constants>
        <name>NL</name>
        <dataType>String</dataType>
        <value>
            <stringValue>
</stringValue>
        </value>
    </constants>
    <formulas>
        <name>ExpansionName</name>
        <dataType>String</dataType>
        <expression>LEFT({!$Record.Account.Name} &amp; " - " &amp; {!$Record.Expansion_Signal__c}, 120)</expression>
    </formulas>
    <formulas>
        <name>ExpansionClose</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 45</expression>
    </formulas>
    <formulas>
        <name>ExpansionAmount</name>
        <dataType>Currency</dataType>
        <scale>0</scale>
        <expression>IF(OR(ISBLANK({!$Record.Account.Location_Count__c}), {!$Record.Account.Location_Count__c} = 0), 12000, ROUND({!$Record.Account.Monthly_Budget_Cap__c} / {!$Record.Account.Location_Count__c}, -2) * 12)</expression>
    </formulas>
    <formulas>
        <name>ExpansionDescription</name>
        <dataType>String</dataType>
        <expression>"Fin heard this in a conversation with " &amp; {!$Record.Contact.FirstName} &amp; " " &amp; {!$Record.Contact.LastName} &amp; " on " &amp; TEXT(TODAY()) &amp; ": " &amp; {!$Record.Expansion_Signal__c} &amp; ". Case " &amp; {!$Record.CaseNumber} &amp; "."</expression>
    </formulas>
    <formulas>
        <name>LocationStatus</name>
        <dataType>String</dataType>
        <expression>IF(TEXT({!Loop_Locations.Budget_Status__c}) = "Active", "", " (" &amp; TEXT({!Loop_Locations.Budget_Status__c}) &amp; ")")</expression>
    </formulas>
    <formulas>
        <name>BriefSubject</name>
        <dataType>String</dataType>
        <expression>"Renewal brief: " &amp; {!$Record.Account.Name}</expression>
    </formulas>
    <formulas>
        <name>NextStep</name>
        <dataType>String</dataType>
        <expression>"Call " &amp; {!$Record.Contact.FirstName} &amp; " this week. " &amp; IF(TEXT({!$Record.Churn_Risk__c}) = "High", "Save " &amp; {!$Record.Fin_Location__c} &amp; " before the renewal: offer the 90-day pause or a performance credit. ", "") &amp; IF(ISBLANK({!$Record.Expansion_Signal__c}), "", "Scope the new location (expansion opportunity created) and launch its ads before it opens.")</expression>
    </formulas>
    <textTemplates>
        <name>LocationLine</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>- {!Loop_Locations.Name}: ${!Loop_Locations.Monthly_Budget_Cap__c}/mo, {!Loop_Locations.Leads_Last_30_Days__c} leads, ${!Loop_Locations.Cost_Per_Lead__c}/lead{!LocationStatus}</text>
    </textTemplates>
    <textTemplates>
        <name>Brief</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>Fin flagged {!$Record.Account.Name} in a conversation with {!$Record.Contact.FirstName} {!$Record.Contact.LastName} today.

Health
- Churn risk: {!$Record.Churn_Risk__c} ({!$Record.Churn_Risk_Reason__c})
- Expansion signal: {!$Record.Expansion_Signal__c}
- Sentiment: {!$Record.Fin_Sentiment__c}
- Open cases: {!OpenCases}

Renewal
- {!Get_Renewal.Name}: ${!Get_Renewal.Amount}, closes {!Get_Renewal.CloseDate}

Spend by location{!SpendByLocation}

Suggested next step
{!NextStep}

Fin summary
{!$Record.Fin_Summary__c}</text>
    </textTemplates>
    <variables>
        <name>SpendByLocation</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>OpenCases</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
    </variables>
    <variables>
        <name>ExpansionId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>