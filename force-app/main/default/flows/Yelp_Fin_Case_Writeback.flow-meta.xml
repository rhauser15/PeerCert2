<?xml version='1.0' encoding='UTF-8'?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <description>Keep and Grow demo. When Fin hands a conversation to the team, write Fin's churn risk, expansion signal and sentiment back to the Account and open an Expansion opportunity if Fin heard one. (The account owner is alerted when the case is resolved: Yelp - Fin Case Resolved Alert.)</description>
    <label>Yelp - Fin Case Write-back</label>
    <processType>AutoLaunchedFlow</processType>
    <status>Active</status>
    <interviewLabel>Fin Write-back {!$Record.CaseNumber}</interviewLabel>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Account</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>FinInvolved__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Origin</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Chat</stringValue>
            </value>
        </filters>
        <filters>
            <field>AccountId</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>FinResolutionState__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Routed to team</stringValue>
            </value>
        </filters>
        <object>Case</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <recordUpdates>
        <name>Update_Account</name>
        <label>Write Fin signals to Account</label>
        <locationX>176</locationX>
        <locationY>150</locationY>
        <connector>
            <targetReference>Has_Expansion</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.AccountId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Churn_Risk__c</field>
            <value>
                <elementReference>$Record.Churn_Risk__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Churn_Risk_Reason__c</field>
            <value>
                <elementReference>$Record.Churn_Risk_Reason__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Expansion_Signal__c</field>
            <value>
                <elementReference>$Record.Expansion_Signal__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Fin_Sentiment__c</field>
            <value>
                <elementReference>$Record.Fin_Sentiment__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Last_Fin_Conversation__c</field>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </inputAssignments>
        <object>Account</object>
    </recordUpdates>
    <decisions>
        <name>Has_Expansion</name>
        <label>Did Fin hear an expansion signal?</label>
        <locationX>176</locationX>
        <locationY>270</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_Expansion</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Expansion_Signal__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Expansion</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <recordCreates>
        <name>Create_Expansion</name>
        <label>Create Expansion Opportunity</label>
        <locationX>50</locationX>
        <locationY>390</locationY>
        <assignRecordIdToReference>ExpansionId</assignRecordIdToReference>
        <inputAssignments>
            <field>Name</field>
            <value>
                <elementReference>ExpansionName</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>AccountId</field>
            <value>
                <elementReference>$Record.AccountId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>$Record.Account.OwnerId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Type</field>
            <value>
                <stringValue>Add-On Business</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>StageName</field>
            <value>
                <stringValue>Qualification</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>CloseDate</field>
            <value>
                <elementReference>ExpansionClose</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Amount</field>
            <value>
                <elementReference>ExpansionAmount</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Description</field>
            <value>
                <elementReference>ExpansionDescription</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Part2_Demo__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <object>Opportunity</object>
    </recordCreates>
    <formulas>
        <name>ExpansionName</name>
        <dataType>String</dataType>
        <expression>LEFT({!$Record.Account.Name} &amp; " - " &amp; {!$Record.Expansion_Signal__c}, 120)</expression>
    </formulas>
    <formulas>
        <name>ExpansionClose</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 45</expression>
    </formulas>
    <formulas>
        <name>ExpansionAmount</name>
        <dataType>Currency</dataType>
        <scale>0</scale>
        <expression>IF(OR(ISBLANK({!$Record.Account.Location_Count__c}), {!$Record.Account.Location_Count__c} = 0), 12000, ROUND({!$Record.Account.Monthly_Budget_Cap__c} / {!$Record.Account.Location_Count__c}, -2) * 12) * IF(ISNUMBER(LEFT({!$Record.Expansion_Signal__c}, FIND(" ", {!$Record.Expansion_Signal__c}) - 1)), VALUE(LEFT({!$Record.Expansion_Signal__c}, FIND(" ", {!$Record.Expansion_Signal__c}) - 1)), 1)</expression>
    </formulas>
    <formulas>
        <name>ExpansionDescription</name>
        <dataType>String</dataType>
        <expression>"Fin heard this in a conversation with " &amp; {!$Record.Contact.FirstName} &amp; " " &amp; {!$Record.Contact.LastName} &amp; " on " &amp; TEXT(TODAY()) &amp; ": " &amp; {!$Record.Expansion_Signal__c} &amp; ". Case " &amp; {!$Record.CaseNumber} &amp; "."</expression>
    </formulas>
    <variables>
        <name>ExpansionId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>