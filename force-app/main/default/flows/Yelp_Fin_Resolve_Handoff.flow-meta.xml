<?xml version='1.0' encoding='UTF-8'?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <description>Keep and Grow demo. Support Tools on the Messaging Session page: pick a location and a retention action, then Confirm. Applies the action to the location and records it on the case Fin opened. The case stays open until the agent marks it resolved.</description>
    <label>Support Tools</label>
    <processType>Flow</processType>
    <status>Active</status>
    <interviewLabel>Support Tools {!$Flow.CurrentDateTime}</interviewLabel>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Session</targetReference>
        </connector>
    </start>
    <recordLookups>
        <name>Get_Session</name>
        <label>Get Session</label>
        <locationX>176</locationX>
        <locationY>130</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Case</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>MessagingSession</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Case</name>
        <label>Get Fin Case</label>
        <locationX>176</locationX>
        <locationY>250</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Has_Case</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Session.Fin_Case__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Case</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Location</name>
        <label>Get the location Fin flagged</label>
        <locationX>50</locationX>
        <locationY>490</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Tools</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ParentId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Case.AccountId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Name</field>
            <operator>Contains</operator>
            <value>
                <elementReference>Get_Case.Fin_Location__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Account</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Selected</name>
        <label>Get Selected Location</label>
        <faultConnector>
            <targetReference>Done</targetReference>
        </faultConnector>
        <locationX>50</locationX>
        <locationY>730</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Which_Action</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Location</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Account</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <choices>
        <name>c_program</name>
        <choiceText>Enroll in New Location Launch Program ($500 credit per new location)</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>New Location Launch Program</stringValue>
        </value>
    </choices>
    <choices>
        <name>c_shift</name>
        <choiceText>Temporary budget shift to new locations (up to 20%, 90 days)</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Budget shift</stringValue>
        </value>
    </choices>
    <choices>
        <name>c_review</name>
        <choiceText>Free Ads Optimization review</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Free ads review</stringValue>
        </value>
    </choices>
    <choices>
        <name>c_pause</name>
        <choiceText>Pause ads for 90 days, no fee</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>90-day pause</stringValue>
        </value>
    </choices>
    <decisions>
        <name>Has_Case</name>
        <label>Is there an open Fin case?</label>
        <locationX>176</locationX>
        <locationY>370</locationY>
        <defaultConnector>
            <targetReference>No_Case</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Open_Case</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Case.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Case.IsClosed</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Location</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Which_Action</name>
        <label>Which action?</label>
        <locationX>50</locationX>
        <locationY>850</locationY>
        <defaultConnector>
            <targetReference>Record_On_Case</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Credit or review</defaultConnectorLabel>
        <rules>
            <name>Pause</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Action</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>90-day pause</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Location</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Pause_Location</targetReference>
            </connector>
            <label>Pause</label>
        </rules>
    </decisions>
    <screens>
        <name>Tools</name>
        <label>Support tools</label>
        <locationX>50</locationX>
        <locationY>610</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Get_Selected</targetReference>
        </connector>
        <fields>
            <name>Header</name>
            <fieldText>&lt;p&gt;&lt;b style="font-size:14px"&gt;Support tools&lt;/b&gt;&lt;/p&gt;&lt;p&gt;{!Get_Case.Account.Name} · Case {!Get_Case.CaseNumber}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>Location</name>
            <choiceReferences>LocationChoices</choiceReferences>
            <dataType>String</dataType>
            <defaultValue>
                <elementReference>Get_Location.Id</elementReference>
            </defaultValue>
            <fieldText>Location (for a budget shift or pause)</fieldText>
            <fieldType>DropdownBox</fieldType>
            <isRequired>false</isRequired>
        </fields>
        <fields>
            <name>Action</name>
            <choiceReferences>c_program</choiceReferences>
            <choiceReferences>c_shift</choiceReferences>
            <choiceReferences>c_review</choiceReferences>
            <choiceReferences>c_pause</choiceReferences>
            <dataType>String</dataType>
            <defaultSelectedChoiceReference>c_program</defaultSelectedChoiceReference>
            <fieldText>Action</fieldText>
            <fieldType>RadioButtons</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>Notes</name>
            <dataType>String</dataType>
            <defaultValue>
                <elementReference>NotesDefault</elementReference>
            </defaultValue>
            <fieldText>Notes</fieldText>
            <fieldType>LargeTextArea</fieldType>
            <isRequired>false</isRequired>
        </fields>
        <nextOrFinishButtonLabel>Confirm</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <screens>
        <name>Done</name>
        <label>Done</label>
        <locationX>176</locationX>
        <locationY>1210</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>DoneText</name>
            <fieldText>&lt;p&gt;&lt;b style="font-size:14px"&gt;Support tools&lt;/b&gt;&lt;/p&gt;&lt;p&gt;&lt;b&gt;Done:&lt;/b&gt; {!DoneDetail}&lt;/p&gt;&lt;p&gt;Recorded on case {!Get_Case.CaseNumber}. Mark the case resolved when the conversation is done.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>false</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <screens>
        <name>No_Case</name>
        <label>No open case</label>
        <locationX>314</locationX>
        <locationY>490</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>NoCaseText</name>
            <fieldText>&lt;p&gt;&lt;b style="font-size:14px"&gt;Support tools&lt;/b&gt;&lt;/p&gt;&lt;p&gt;{!NoCaseMessage}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>false</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <recordUpdates>
        <name>Pause_Location</name>
        <label>Pause the location's ads</label>
        <faultConnector>
            <targetReference>Done</targetReference>
        </faultConnector>
        <locationX>50</locationX>
        <locationY>970</locationY>
        <connector>
            <targetReference>Record_On_Case</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Location</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Budget_Status__c</field>
            <value>
                <stringValue>Paused - Customer Request</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Paused_Until__c</field>
            <value>
                <elementReference>PauseUntil</elementReference>
            </value>
        </inputAssignments>
        <object>Account</object>
    </recordUpdates>
    <recordUpdates>
        <name>Record_On_Case</name>
        <label>Record the action on the case</label>
        <faultConnector>
            <targetReference>Done</targetReference>
        </faultConnector>
        <locationX>176</locationX>
        <locationY>1090</locationY>
        <connector>
            <targetReference>Done</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Case.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Retention_Offer__c</field>
            <value>
                <elementReference>Action</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Resolution_Notes__c</field>
            <value>
                <elementReference>Notes</elementReference>
            </value>
        </inputAssignments>
        <object>Case</object>
    </recordUpdates>
    <dynamicChoiceSets>
        <name>LocationChoices</name>
        <dataType>String</dataType>
        <displayField>Name</displayField>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ParentId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Case.AccountId</elementReference>
            </value>
        </filters>
        <object>Account</object>
        <sortField>Name</sortField>
        <sortOrder>Asc</sortOrder>
        <valueField>Id</valueField>
    </dynamicChoiceSets>
    <formulas>
        <name>PauseUntil</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 90</expression>
    </formulas>
    <formulas>
        <name>CreditAmount</name>
        <dataType>Currency</dataType>
        <scale>0</scale>
        <expression>ROUND(BLANKVALUE({!Get_Location.Monthly_Budget_Cap__c}, 0) * 0.2, 0)</expression>
    </formulas>
    <formulas>
        <name>DoneDetail</name>
        <dataType>String</dataType>
        <expression>CASE({!Action},
"New Location Launch Program", {!Get_Case.Account.Name} &amp; " is enrolled in the New Location Launch Program: $500 in ad credit for each new location in its first 60 days.",
"Budget shift", "Temporary budget shift set up: up to 20% of " &amp; IF(ISBLANK({!Get_Selected.Name}), "existing locations", {!Get_Selected.Name}) &amp; " budget moves to the new locations for 90 days.",
"Free ads review", "Free Ads Optimization review requested.",
IF(ISBLANK({!Get_Selected.Name}), "Pick a location to pause.", {!Get_Selected.Name} &amp; " is paused until " &amp; TEXT(TODAY() + 90) &amp; ", no fee."))</expression>
    </formulas>
    <formulas>
        <name>NoCaseMessage</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!Get_Case.Id}), "No Fin handoff case on this conversation.", "Case " &amp; {!Get_Case.CaseNumber} &amp; " is resolved. Retention offer: " &amp; TEXT({!Get_Case.Retention_Offer__c}) &amp; ".")</expression>
    </formulas>
    <textTemplates>
        <name>NotesDefault</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>{!Get_Case.Contact.FirstName} is opening {!Get_Case.Expansion_Signal__c} and wants to see performance before investing more. Enrolled in the New Location Launch Program ($500 credit per new location). Account manager to book an Ads Optimization Review.</text>
    </textTemplates>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>