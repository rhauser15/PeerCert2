<?xml version='1.0' encoding='UTF-8'?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <description>Keep and Grow demo. On the Messaging Session page: the agent records the retention offer the customer accepted, applies it to the location, and closes the case Fin opened at handoff.</description>
    <label>Resolve Fin Handoff</label>
    <processType>Flow</processType>
    <status>Active</status>
    <interviewLabel>Resolve Fin Handoff {!$Flow.CurrentDateTime}</interviewLabel>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Session</targetReference>
        </connector>
    </start>
    <recordLookups>
        <name>Get_Session</name>
        <label>Get Session</label>
        <locationX>176</locationX>
        <locationY>130</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Case</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>MessagingSession</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Case</name>
        <label>Get Fin Case</label>
        <locationX>176</locationX>
        <locationY>250</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Has_Case</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Session.Fin_Case__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Case</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Location</name>
        <label>Get Location</label>
        <locationX>50</locationX>
        <locationY>490</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Resolve</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ParentId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Case.AccountId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Name</field>
            <operator>Contains</operator>
            <value>
                <elementReference>Get_Case.Fin_Location__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Account</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <decisions>
        <name>Has_Case</name>
        <label>Is there an open Fin case?</label>
        <locationX>176</locationX>
        <locationY>370</locationY>
        <defaultConnector>
            <targetReference>No_Case</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Open_Case</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Case.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Case.IsClosed</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Location</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Pause</name>
        <label>Pause the location?</label>
        <locationX>50</locationX>
        <locationY>730</locationY>
        <defaultConnector>
            <targetReference>Close_Case</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Pause</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Offer</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>90-day pause</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Location.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Pause_Location</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <screens>
        <name>Resolve</name>
        <label>Resolve</label>
        <locationX>50</locationX>
        <locationY>610</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Is_Pause</targetReference>
        </connector>
        <fields>
            <name>Intro</name>
            <fieldText>&lt;p&gt;&lt;b&gt;Case {!Get_Case.CaseNumber}&lt;/b&gt; · {!Get_Case.Fin_Contact_Reason__c} · {!Get_Location.Name}&lt;/p&gt;&lt;p&gt;Record what the customer accepted. Pausing updates the location right away.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>Offer</name>
            <choiceReferences>c_pause</choiceReferences>
            <choiceReferences>c_credit</choiceReferences>
            <choiceReferences>c_review</choiceReferences>
            <choiceReferences>c_cancel</choiceReferences>
            <dataType>String</dataType>
            <defaultSelectedChoiceReference>c_pause</defaultSelectedChoiceReference>
            <fieldText>Retention offer accepted</fieldText>
            <fieldType>RadioButtons</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>Notes</name>
            <dataType>String</dataType>
            <defaultValue>
                <elementReference>NotesDefault</elementReference>
            </defaultValue>
            <fieldText>Resolution notes</fieldText>
            <fieldType>LargeTextArea</fieldType>
            <isRequired>false</isRequired>
        </fields>
        <nextOrFinishButtonLabel>Resolve case</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <screens>
        <name>Done</name>
        <label>Done</label>
        <locationX>176</locationX>
        <locationY>1090</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>DoneText</name>
            <fieldText>&lt;p&gt;&lt;b&gt;Case {!Get_Case.CaseNumber} resolved.&lt;/b&gt; Retention offer: {!Offer}.&lt;/p&gt;&lt;p&gt;{!DoneDetail}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>false</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <screens>
        <name>No_Case</name>
        <label>No open case</label>
        <locationX>314</locationX>
        <locationY>490</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>NoCaseText</name>
            <fieldText>&lt;p&gt;{!NoCaseMessage}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>false</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <recordUpdates>
        <name>Pause_Location</name>
        <label>Pause the location's ads</label>
        <locationX>50</locationX>
        <locationY>850</locationY>
        <connector>
            <targetReference>Close_Case</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Location.Id</elementReference>
            </value>
        </filters>
        <object>Account</object>
        <inputAssignments>
            <field>Budget_Status__c</field>
            <value>
                <stringValue>Paused - Customer Request</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Paused_Until__c</field>
            <value>
                <elementReference>PauseUntil</elementReference>
            </value>
        </inputAssignments>
    </recordUpdates>
    <recordUpdates>
        <name>Close_Case</name>
        <label>Resolve the case</label>
        <locationX>176</locationX>
        <locationY>970</locationY>
        <connector>
            <targetReference>Done</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Case.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Closed</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Retention_Offer__c</field>
            <value>
                <elementReference>Offer</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Resolution_Notes__c</field>
            <value>
                <elementReference>Notes</elementReference>
            </value>
        </inputAssignments>
        <object>Case</object>
    </recordUpdates>
    <choices>
        <name>c_pause</name>
        <choiceText>Pause ads for 90 days, no fee</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>90-day pause</stringValue>
        </value>
    </choices>
    <choices>
        <name>c_credit</name>
        <choiceText>Performance credit: {!CreditAmount}/month for 2 months</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Performance credit</stringValue>
        </value>
    </choices>
    <choices>
        <name>c_review</name>
        <choiceText>Free Ads Optimization review</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Free ads review</stringValue>
        </value>
    </choices>
    <choices>
        <name>c_cancel</name>
        <choiceText>Cancel the location</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>None - location cancelled</stringValue>
        </value>
    </choices>
    <formulas>
        <name>PauseUntil</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 90</expression>
    </formulas>
    <formulas>
        <name>CreditAmount</name>
        <dataType>Currency</dataType>
        <scale>0</scale>
        <expression>ROUND(BLANKVALUE({!Get_Location.Monthly_Budget_Cap__c}, 0) * 0.2, 0)</expression>
    </formulas>
    <formulas>
        <name>DoneDetail</name>
        <dataType>String</dataType>
        <expression>IF({!Offer} = "90-day pause", {!Get_Location.Name} &amp; " is paused until " &amp; TEXT(TODAY() + 90) &amp; ". The page and reviews stay live. ", "") &amp; IF(ISBLANK({!Get_Case.Expansion_Signal__c}), "", "The expansion opportunity is with the account owner.")</expression>
    </formulas>
    <formulas>
        <name>NoCaseMessage</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!Get_Case.Id}), "No Fin handoff case on this conversation.", "Case " &amp; {!Get_Case.CaseNumber} &amp; " is resolved. Retention offer: " &amp; TEXT({!Get_Case.Retention_Offer__c}) &amp; ".")</expression>
    </formulas>
    <textTemplates>
        <name>NotesDefault</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>{!Get_Case.Contact.FirstName} asked to cancel {!Get_Case.Fin_Location__c} and chose a 90-day pause instead, with its budget moving to the new location. {!Get_Case.Expansion_Signal__c}: handed to the account owner.</text>
    </textTemplates>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>