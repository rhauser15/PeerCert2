<?xml version='1.0' encoding='UTF-8'?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <description>Keep and Grow demo. The org's generic Messaging Session automation opens its own case for every new session. For Fin handoffs, remove that extra case and keep the session linked to the case Fin created.</description>
    <label>Yelp - Fin Session Keep Fin Case</label>
    <processType>AutoLaunchedFlow</processType>
    <status>Active</status>
    <interviewLabel>Keep Fin Case {!$Flow.CurrentDateTime}</interviewLabel>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Replaced</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Fin_Case__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>CaseId</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>MessagingSession</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <decisions>
        <name>Replaced</name>
        <label>Was the Fin case replaced?</label>
        <locationX>176</locationX>
        <locationY>150</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_Replaced</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.CaseId</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Fin_Case__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Relink</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <recordUpdates>
        <name>Relink</name>
        <label>Link the Fin case again</label>
        <locationX>50</locationX>
        <locationY>270</locationY>
        <connector>
            <targetReference>Remove_Extra_Case</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>CaseId</field>
            <value>
                <elementReference>$Record.Fin_Case__c</elementReference>
            </value>
        </inputAssignments>
        <object>MessagingSession</object>
    </recordUpdates>
    <recordDeletes>
        <name>Remove_Extra_Case</name>
        <label>Remove the generic case</label>
        <locationX>50</locationX>
        <locationY>390</locationY>
        <faultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Done</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.CaseId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Subject</field>
            <operator>StartsWith</operator>
            <value>
                <stringValue>Support </stringValue>
            </value>
        </filters>
        <object>Case</object>
    </recordDeletes>
    <assignments>
        <name>Done</name>
        <label>Done</label>
        <locationX>50</locationX>
        <locationY>510</locationY>
        <assignmentItems>
            <assignToReference>Ignored</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
    </assignments>
    <variables>
        <name>Ignored</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>