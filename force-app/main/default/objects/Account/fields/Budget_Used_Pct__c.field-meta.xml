<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Budget_Used_Pct__c</fullName>
    <label>Budget Used (MTD)</label>
    <description>Share of this month's ad budget spent, across all locations.</description>
    <formula>IF(OR(ISBLANK(Monthly_Budget_Cap__c), Monthly_Budget_Cap__c = 0), 0, ROUND(Budget_Spent_MTD__c / Monthly_Budget_Cap__c * 100, 0))</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <type>Number</type><precision>3</precision><scale>0</scale>
</CustomField>
